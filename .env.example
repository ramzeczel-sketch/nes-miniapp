# Port for the HTTP + WebSocket server
PORT=8795

# Token of the NEW bot you create via @BotFather (placeholder, never commit the real one).
# If set, Telegram initData is validated (HMAC-SHA256) and connections without valid initData are rejected.
# If empty, the app works without validation (fine for local testing).
BOT_TOKEN=

# Bot username without @, used to build invite links https://t.me/<BOT_USERNAME>?startapp=<code>
BOT_USERNAME=

# Optional: Mini App short name if you use direct link form https://t.me/<bot>/<short_name>?startapp=<code>
APP_SHORT_NAME=

# 1 = allow opening the app in a normal browser even if BOT_TOKEN is set (debug only)
ALLOW_GUESTS=0
